# Mojang-owned inputs acquired locally by the port scripts.
*.jar
client.txt
assets/
libraries/
versions/
!port/versions/
!port/versions/*.json
port/work/

# Rebuildable Maven data and diagnostic output. The checked-in browser release
# under port/web/dist and platform smoke bundles use Git LFS; do not ignore
# them, because a source commit and its runnable browser package are released
# together.
port/target/
apps/server-plugin/target/

# Keep browser platform-overlay source visible while ignoring any other local
# copied library trees.
!port/overrides/libraries/
port/overrides/libraries/*
!port/overrides/libraries/lwjgl-openal/
!port/overrides/libraries/lwjgl-openal/**
!port/overrides/libraries/lwjgl-opengl/
!port/overrides/libraries/lwjgl-opengl/**
!port/overrides/libraries/lwjgl-glfw/
!port/overrides/libraries/lwjgl-glfw/**
!port/overrides/libraries/lwjgl-stb/
!port/overrides/libraries/lwjgl-stb/**
!port/overrides/libraries/netty-transport/
!port/overrides/libraries/netty-transport/**

# Local dependencies, environment files, coverage, and editor state.
node_modules/
.pnpm-store/
.npm/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.DS_Store
.idea/
.vscode/
*.iml
*.log
*.log.gz
logs/
*.tsbuildinfo
coverage/
.coverage
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
