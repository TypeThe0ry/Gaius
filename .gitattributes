# The fixed multiplayer acceptance resource pack is stored in LFS. The Pages
# workflow no longer checks out the repository (it publishes only the release's
# Gaius-26.2.html), so it does not materialize these LFS objects.
docs/resource-packs/*.zip filter=lfs diff=lfs merge=lfs -text

# The checked-in browser release is one coherent deliverable. Keep it in this
# repository through Git LFS so source and a downloadable build share a commit
# without placing large blobs in ordinary Git history.
port/web/dist/** filter=lfs diff=lfs merge=lfs -text
port/web/smoke/platform-smoke*.js filter=lfs diff=lfs merge=lfs -text
port/web/smoke/platform-smoke*.js.map filter=lfs diff=lfs merge=lfs -text
port/web/smoke/platform-smoke*.js.teavmdbg filter=lfs diff=lfs merge=lfs -text
port/web/smoke/**/platform-smoke*.js filter=lfs diff=lfs merge=lfs -text
port/web/smoke/**/platform-smoke*.js.map filter=lfs diff=lfs merge=lfs -text
port/web/smoke/**/platform-smoke*.js.teavmdbg filter=lfs diff=lfs merge=lfs -text
