  "frameCases": [
    {
      "name": "one-percent-low-is-slowest-one-percent-mean",
      "assertDistinctFromP99Reciprocal": true,
      "elapsedMs": 8300,
      "segments": [
        {"frameMs": 8, "count": 990},
        {"frameMs": 20, "count": 9},
        {"frameMs": 100, "count": 1}
      ],
      "expected": {
        "sampleCount": 1000,
        "p99FrameMs": 8,
        "onePercentSlowestFrameCount": 10,
        "onePercentSlowestMeanFrameMs": 28,
        "onePercentLowFps": 35.714,
        "longestFrameMs": 100
      }
    },
    {
      "name": "default-gate-passes-at-contract-boundary",
      "assertDistinctFromP99Reciprocal": false,
      "elapsedMs": 8333.333,
      "segments": [
        {"frameMs": 8.333333, "count": 1000}
      ],
      "expected": {
        "averageFps": 120,
        "onePercentLowFps": 120,
        "atLeast500Ms": 0
      }
    }
  ],
  "ringCases": [
    {
      "name": "recover-wrapped-delta-in-chronological-order",
